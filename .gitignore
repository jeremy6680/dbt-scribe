# =============================================================================
# dbt-scribe — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── dbt-scribe specific ───────────────────────────────────────────────────────
# LLM response cache — keyed on compiled SQL + config fingerprint
.dbt-scribe-cache/

# DuckDB files from test projects
*.duckdb
*.duckdb.wal

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Editors and OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log

# Claude Code local settings
.claude/